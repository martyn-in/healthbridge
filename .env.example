# HealthBridge AI Environment Variables
# When keys are omitted, HealthBridge AI automatically runs in Judge Demo Mode with rich realistic seeded data.

# Application Mode
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEMO_MODE=true

# AI Provider API Keys (Optional - falls back to built-in clinical rule engine + AI simulation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Database / Backend (Optional - falls back to local state & persisted storage)
NEXT_PUBLIC_CONVEX_URL=

# Maps API Key (Optional - falls back to OpenStreetMap / Interactive Demo Map)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Auth (Optional - falls back to flexible local auth & Judge Demo login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
